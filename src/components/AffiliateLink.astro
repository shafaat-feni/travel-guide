---
interface Props {
  href: string;
  partnerName: string;
  badge?: boolean;
}

const { href, partnerName, badge = true } = Astro.props;
---

<span class="affiliate-link-wrapper">
  <a 
    href={href} 
    target="_blank" 
    rel="sponsored nofollow noopener" 
    class="affiliate-link"
  >
    <slot />
    <span class="sr-only"> (opens partner site {partnerName})</span>
  </a>
  {badge && <span class="affiliate-badge" title="We may earn a commission if you book through this link">Partner Link</span>}
</span>

<style>
  .affiliate-link-wrapper {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
    flex-wrap: wrap;
  }

  .affiliate-link {
    color: var(--color-primary);
    font-weight: 600;
    text-decoration: underline;
  }

  .affiliate-badge {
    font-size: 0.6875rem;
    background-color: var(--color-bg);
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    padding: 1px 6px;
    border-radius: var(--radius-sm);
    font-weight: 500;
    white-space: nowrap;
  }
</style>