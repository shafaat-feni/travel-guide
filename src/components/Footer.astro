---
import { SITE_CONFIG } from '@config/site';

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-container">
    <div class="footer-grid">
      <!-- Column 1: Identity & Disclaimer -->
      <div class="footer-col footer-about">
        <h2 class="footer-heading">{SITE_CONFIG.name}</h2>
        <p class="footer-description">
          An independent publication providing practical, factual travel guide information for international visitors to Bangladesh.
        </p>
        <p class="government-disclaimer">
          <strong>Notice:</strong> This site is independently operated and is not affiliated with or endorsed by the Government of Bangladesh.
        </p>
      </div>

      <!-- Column 2: Key Travel Hubs -->
      <div class="footer-col">
        <h3 class="footer-subheading">Essential Guides</h3>
        <ul class="footer-links">
          <li><a href="/plan-your-trip/bangladesh-visa/">Visa Requirements</a></li>
          <li><a href="/plan-your-trip/dhaka-airport-arrival-guide/">Dhaka Airport Arrival</a></li>
          <li><a href="/plan-your-trip/money-and-currency/">Money & ATMs</a></li>
          <li><a href="/plan-your-trip/sim-cards-and-esims/">eSIMs & SIM Cards</a></li>
          <li><a href="/plan-your-trip/transport-in-bangladesh/">Transport Guide</a></li>
          <li><a href="/plan-your-trip/best-time-to-visit/">Best Time to Visit</a></li>
          <li><a href="/plan-your-trip/cultural-etiquette/">Cultural Etiquette</a></li>
        </ul>
      </div>

      <!-- Column 3: Top Destinations -->
      <div class="footer-col">
        <h3 class="footer-subheading">Destinations</h3>
        <ul class="footer-links">
          <li><a href="/destinations/dhaka-travel-guide/">Dhaka</a></li>
          <li><a href="/destinations/cox-s-bazar-travel-guide/">Cox's Bazar</a></li>
          <li><a href="/destinations/sylhet-travel-guide/">Sylhet</a></li>
          <li><a href="/destinations/srimangal-travel-guide/">Srimangal</a></li>
          <li><a href="/destinations/sundarbans-travel-guide/">The Sundarbans</a></li>
          <li><a href="/destinations/chittagong-hill-tracts/">Chittagong Hill Tracts</a></li>
        </ul>
      </div>

      <!-- Column 4: Editorial & Legal -->
      <div class="footer-col">
        <h3 class="footer-subheading">Editorial & Legal</h3>
        <ul class="footer-links">
          <li><a href="/about/">About Us</a></li>
          <li><a href="/editorial-policy/">Editorial Policy</a></li>
          <li><a href="/privacy-policy/">Privacy Policy</a></li>
          <li><a href="/terms-of-use/">Terms of Use</a></li>
          <li><a href="/disclaimer/">Disclaimer</a></li>
          <li><a href="/affiliate-disclosure/">Affiliate Disclosure</a></li>
          <li><a href="/contact/">Contact</a></li>
          <li><a href="/cookie-policy/">Cookie Policy</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {currentYear} {SITE_CONFIG.name}. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-primary-dark);
    color: #e2e8f0;
    padding-top: var(--spacing-xl);
    padding-bottom: var(--spacing-lg);
    margin-top: auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-xl);
  }

  .footer-heading {
    font-family: var(--font-heading);
    color: var(--color-accent);
    font-size: 1.25rem;
    margin-bottom: var(--spacing-sm);
  }

  .footer-subheading {
    font-size: 1rem;
    color: var(--color-surface);
    margin-bottom: var(--spacing-sm);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .footer-description {
    font-size: 0.875rem;
    line-height: 1.5;
    margin-bottom: var(--spacing-sm);
    color: #cbd5e1;
  }

  .government-disclaimer {
    font-size: 0.8125rem;
    color: #94a3b8;
    border-left: 2px solid var(--color-accent);
    padding-left: var(--spacing-sm);
    margin-top: var(--spacing-sm);
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }

  .footer-links a {
    color: #cbd5e1;
    text-decoration: none;
    font-size: 0.875rem;
    display: inline-block;
    padding: var(--spacing-xs) 0;
  }

  .footer-links a:hover,
  .footer-links a:focus-visible {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .footer-bottom {
    margin-top: var(--spacing-xl);
    padding-top: var(--spacing-md);
    border-top: 1px solid #1e293b;
    text-align: center;
    font-size: 0.8125rem;
    color: #94a3b8;
  }

  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .footer-grid {
      grid-template-columns: 2fr 1fr 1fr 1fr;
    }
  }
</style>