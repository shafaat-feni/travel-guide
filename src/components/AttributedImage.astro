---
interface Props {
  src: string;
  alt: string;
  caption: string;
  attributionName: string;
  attributionUrl?: string;
  licenseName: string;
  licenseUrl?: string;
  width?: number;
  height?: number;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
}

const {
  src,
  alt,
  caption,
  attributionName,
  attributionUrl,
  licenseName,
  licenseUrl,
  width = 800,
  height = 450
  loading = 'lazy',
  fetchpriority = 'auto'
} = Astro.props;
---

<figure class="attributed-figure">
  <img 
    src={src} 
    alt={alt} 
    width={width} 
    height={height} 
    loading={loading}
    fetchpriority={fetchpriority}
    class="figure-img"
    onerror="this.style.display='none'; if(this.parentElement) this.parentElement.style.display='none';"
  />
  <figcaption class="figure-caption">
    <span class="caption-text">{caption}</span>
    <span class="attribution-text">
      Photo: 
      {attributionUrl ? (
        <a href={attributionUrl} target="_blank" rel="noopener noreferrer">{attributionName}</a>
      ) : (
        <span>{attributionName}</span>
      )}
      ({licenseUrl ? (
        <a href={licenseUrl} target="_blank" rel="noopener noreferrer">{licenseName}</a>
      ) : (
        <span>{licenseName}</span>
      )})
    </span>
  </figcaption>
</figure>

<style>
  .attributed-figure {
    margin: var(--spacing-lg) 0;
    border-radius: var(--radius-md);
    overflow: hidden;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  .figure-img {
    width: 100%;
    height: auto;
    object-fit: cover;
    display: block;
  }

  .figure-caption {
    padding: var(--spacing-sm) var(--spacing-md);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    background-color: var(--color-bg);
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .caption-text {
    color: var(--color-text);
    font-weight: 500;
  }

  .attribution-text {
    font-size: 0.75rem;
  }

  .attribution-text a {
    color: var(--color-primary);
    text-decoration: underline;
  }
</style>