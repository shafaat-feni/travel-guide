---
interface Props {
  src: string;
  alt: string;
  caption?: string;
  attributionName?: string;
  attributionUrl?: string;
  licenseName?: string;
  licenseUrl?: string;
  width?: number;
  height?: number;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
}

const props = Astro.props;
const src = props.src;
const alt = props.alt;
const caption = props.caption;
const attributionName = props.attributionName;
const attributionUrl = props.attributionUrl;
const licenseName = props.licenseName;
const licenseUrl = props.licenseUrl;
const width = props.width ?? 800;
const height = props.height ?? 450;
const loading = props.loading ?? 'lazy';
const fetchpriority = props.fetchpriority ?? 'auto';
---

{src && (
  <figure class="attributed-figure">
    <div class="image-wrapper">
      <img 
        src={src} 
        alt={alt} 
        width={width} 
        height={height} 
        loading={loading}
        fetchpriority={fetchpriority}
        class="attributed-img"
        onerror="this.style.display='none'; if(this.parentElement) this.parentElement.style.display='none';"
      />
    </div>
    {(caption || attributionName) && (
      <figcaption class="figure-caption">
        {caption && <span class="caption-text">{caption}</span>}
        {attributionName && (
          <span class="attribution-text">
            Image by {attributionUrl ? <a href={attributionUrl} target="_blank" rel="noopener noreferrer">{attributionName}</a> : attributionName}
            {licenseName && (
              <span> under {licenseUrl ? <a href={licenseUrl} target="_blank" rel="noopener noreferrer">{licenseName}</a> : licenseName}</span>
            )}
          </span>
        )}
      </figcaption>
    )}
  </figure>
)}

<style>
  .attributed-figure {
    margin: var(--spacing-lg) 0;
    width: 100%;
  }

  .image-wrapper {
    border-radius: var(--radius-md);
    overflow: hidden;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  .attributed-img {
    width: 100%;
    height: auto;
    object-fit: cover;
    display: block;
  }

  .figure-caption {
    margin-top: var(--spacing-xs);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 0 var(--spacing-xs);
  }

  .caption-text {
    font-weight: 500;
    color: var(--color-text);
  }

  .attribution-text a {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .attribution-text a:hover {
    color: var(--color-primary-dark);
  }
</style>