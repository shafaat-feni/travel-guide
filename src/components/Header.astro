---
const currentPath = Astro.url.pathname;

// Active state helper functions
const isActive = (path: string) => {
  if (path === '/') return currentPath === '/' || currentPath === '/index.html';
  return currentPath === path || currentPath === `${path}/` || currentPath.startsWith(`${path}/`);
};

const isDestinationsActive = currentPath.startsWith('/destinations');
const isPlanTripActive = currentPath.startsWith('/plan-your-trip');
---

<header class="site-header">
  <div class="header-container">
    <!-- Brand Logo / Name -->
    <a href="/" class="brand-link" aria-label="Bangladesh Travel Guide Homepage">
      <span class="brand-icon" aria-hidden="true">❖</span>
      <span class="brand-title">Bangladesh Travel Guide</span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav" aria-label="Main Navigation">
      <ul class="nav-list" role="menubar">
        <!-- Destinations Dropdown Item -->
        <li class={`nav-item has-dropdown ${isDestinationsActive ? 'active-section' : ''}`} role="none">
          <div class="nav-link-wrapper">
            <a 
              href="/destinations/" 
              class={`nav-link ${isDestinationsActive ? 'active' : ''}`}
              role="menuitem"
              aria-current={currentPath === '/destinations/' || currentPath === '/destinations' ? 'page' : undefined}
            >
              Destinations
            </a>
            <button 
              type="button" 
              class="dropdown-toggle"
              aria-expanded="false" 
              aria-haspopup="true" 
              aria-label="Toggle Destinations submenu"
            >
              <svg class="chevron-icon" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
                <path d="M2.5 4.5L6 8L9.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
              </svg>
            </button>
          </div>
          <ul class="dropdown-menu" role="menu" aria-label="Destinations Submenu">
            <li role="none">
              <a href="/destinations/cox-s-bazar-travel-guide/" class={`dropdown-link ${isActive('/destinations/cox-s-bazar-travel-guide/') ? 'active' : ''}`} role="menuitem">
                Cox's Bazar
              </a>
            </li>
            <li role="none">
              <a href="/destinations/sundarbans-travel-guide/" class={`dropdown-link ${isActive('/destinations/sundarbans-travel-guide/') ? 'active' : ''}`} role="menuitem">
                Sundarbans
              </a>
            </li>
            <li role="none">
              <a href="/destinations/chittagong-hill-tracts/" class={`dropdown-link ${isActive('/destinations/chittagong-hill-tracts/') ? 'active' : ''}`} role="menuitem">
                Chittagong Hill Tracts
              </a>
            </li>
            <li role="none">
              <a href="/destinations/dhaka-travel-guide/" class={`dropdown-link ${isActive('/destinations/dhaka-travel-guide/') ? 'active' : ''}`} role="menuitem">
                Dhaka
              </a>
            </li>
            <li role="none">
              <a href="/destinations/sylhet-travel-guide/" class={`dropdown-link ${isActive('/destinations/sylhet-travel-guide/') ? 'active' : ''}`} role="menuitem">
                Sylhet
              </a>
            </li>
            <li role="none">
              <a href="/destinations/srimangal-travel-guide/" class={`dropdown-link ${isActive('/destinations/srimangal-travel-guide/') ? 'active' : ''}`} role="menuitem">
                Srimangal
              </a>
            </li>
          </ul>
        </li>

        <!-- Plan Your Trip Dropdown Item -->
        <li class={`nav-item has-dropdown ${isPlanTripActive ? 'active-section' : ''}`} role="none">
          <div class="nav-link-wrapper">
            <a 
              href="/plan-your-trip/" 
              class={`nav-link ${isPlanTripActive ? 'active' : ''}`}
              role="menuitem"
              aria-current={currentPath === '/plan-your-trip/' || currentPath === '/plan-your-trip' ? 'page' : undefined}
            >
              Plan Your Trip
            </a>
            <button 
              type="button" 
              class="dropdown-toggle"
              aria-expanded="false" 
              aria-haspopup="true" 
              aria-label="Toggle Plan Your Trip submenu"
            >
              <svg class="chevron-icon" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
                <path d="M2.5 4.5L6 8L9.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
              </svg>
            </button>
          </div>
          <ul class="dropdown-menu" role="menu" aria-label="Plan Your Trip Submenu">
            <li role="none">
              <a href="/plan-your-trip/bangladesh-visa/" class={`dropdown-link ${isActive('/plan-your-trip/bangladesh-visa/') ? 'active' : ''}`} role="menuitem">
                Visa & Entry Rules
              </a>
            </li>
            <li role="none">
              <a href="/plan-your-trip/dhaka-airport-arrival-guide/" class={`dropdown-link ${isActive('/plan-your-trip/dhaka-airport-arrival-guide/') ? 'active' : ''}`} role="menuitem">
                Airport Arrival (DAC)
              </a>
            </li>
            <li role="none">
              <a href="/plan-your-trip/best-time-to-visit/" class={`dropdown-link ${isActive('/plan-your-trip/best-time-to-visit/') ? 'active' : ''}`} role="menuitem">
                Best Time to Visit
              </a>
            </li>
            <li role="none">
              <a href="/plan-your-trip/money-and-currency/" class={`dropdown-link ${isActive('/plan-your-trip/money-and-currency/') ? 'active' : ''}`} role="menuitem">
                Money & ATMs
              </a>
            </li>
            <li role="none">
              <a href="/plan-your-trip/sim-cards-and-esims/" class={`dropdown-link ${isActive('/plan-your-trip/sim-cards-and-esims/') ? 'active' : ''}`} role="menuitem">
                SIM Cards & eSIMs
              </a>
            </li>
            <li role="none">
              <a href="/plan-your-trip/transport-in-bangladesh/" class={`dropdown-link ${isActive('/plan-your-trip/transport-in-bangladesh/') ? 'active' : ''}`} role="menuitem">
                Transport & Getting Around
              </a>
            </li>
            <li role="none">
              <a href="/plan-your-trip/cultural-etiquette/" class={`dropdown-link ${isActive('/plan-your-trip/cultural-etiquette/') ? 'active' : ''}`} role="menuitem">
                Cultural Etiquette
              </a>
            </li>
          </ul>
        </li>

        <!-- Regular Links -->
        <li class="nav-item" role="none">
          <a href="/bangladesh-travel-safety/" class={`nav-link ${isActive('/bangladesh-travel-safety/') ? 'active' : ''}`} role="menuitem">
            Safety & Security
          </a>
        </li>
        <li class="nav-item" role="none">
          <a href="/bangladesh-travel-health/" class={`nav-link ${isActive('/bangladesh-travel-health/') ? 'active' : ''}`} role="menuitem">
            Health Care
          </a>
        </li>
        <li class="nav-item" role="none">
          <a href="/about/" class={`nav-link ${isActive('/about/') ? 'active' : ''}`} role="menuitem">
            About
          </a>
        </li>
      </ul>
    </nav>

    <!-- Mobile Menu Toggle Button -->
    <button 
      type="button" 
      class="mobile-menu-toggle" 
      id="mobileMenuToggle" 
      aria-expanded="false" 
      aria-controls="mobileNav"
      aria-label="Toggle navigation menu"
    >
      <span class="hamburger-icon" aria-hidden="true"></span>
    </button>
  </div>

  <!-- Mobile Navigation Slide-down Panel -->
  <nav class="mobile-nav" id="mobileNav" aria-label="Mobile Navigation" hidden>
    <ul class="mobile-nav-list">
      <!-- Mobile Destinations Dropdown -->
      <li class={`mobile-nav-item mobile-has-dropdown ${isDestinationsActive ? 'open' : ''}`}>
        <div class="mobile-nav-row">
          <a href="/destinations/" class={`mobile-nav-link ${isDestinationsActive ? 'active' : ''}`}>
            Destinations
          </a>
          <button 
            type="button" 
            class="mobile-dropdown-btn" 
            aria-expanded={isDestinationsActive ? 'true' : 'false'}
            aria-label="Expand Destinations menu"
          >
            <svg class="chevron-icon" width="16" height="16" viewBox="0 0 12 12" aria-hidden="true">
              <path d="M2.5 4.5L6 8L9.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
            </svg>
          </button>
        </div>
        <ul class="mobile-submenu">
          <li><a href="/destinations/cox-s-bazar-travel-guide/" class={`mobile-sublink ${isActive('/destinations/cox-s-bazar-travel-guide/') ? 'active' : ''}`}>Cox's Bazar</a></li>
          <li><a href="/destinations/sundarbans-travel-guide/" class={`mobile-sublink ${isActive('/destinations/sundarbans-travel-guide/') ? 'active' : ''}`}>Sundarbans</a></li>
          <li><a href="/destinations/chittagong-hill-tracts/" class={`mobile-sublink ${isActive('/destinations/chittagong-hill-tracts/') ? 'active' : ''}`}>Chittagong Hill Tracts</a></li>
          <li><a href="/destinations/dhaka-travel-guide/" class={`mobile-sublink ${isActive('/destinations/dhaka-travel-guide/') ? 'active' : ''}`}>Dhaka</a></li>
          <li><a href="/destinations/sylhet-travel-guide/" class={`mobile-sublink ${isActive('/destinations/sylhet-travel-guide/') ? 'active' : ''}`}>Sylhet</a></li>
          <li><a href="/destinations/srimangal-travel-guide/" class={`mobile-sublink ${isActive('/destinations/srimangal-travel-guide/') ? 'active' : ''}`}>Srimangal</a></li>
        </ul>
      </li>

      <!-- Mobile Plan Your Trip Dropdown -->
      <li class={`mobile-nav-item mobile-has-dropdown ${isPlanTripActive ? 'open' : ''}`}>
        <div class="mobile-nav-row">
          <a href="/plan-your-trip/" class={`mobile-nav-link ${isPlanTripActive ? 'active' : ''}`}>
            Plan Your Trip
          </a>
          <button 
            type="button" 
            class="mobile-dropdown-btn" 
            aria-expanded={isPlanTripActive ? 'true' : 'false'}
            aria-label="Expand Plan Your Trip menu"
          >
            <svg class="chevron-icon" width="16" height="16" viewBox="0 0 12 12" aria-hidden="true">
              <path d="M2.5 4.5L6 8L9.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
            </svg>
          </button>
        </div>
        <ul class="mobile-submenu">
          <li><a href="/plan-your-trip/bangladesh-visa/" class={`mobile-sublink ${isActive('/plan-your-trip/bangladesh-visa/') ? 'active' : ''}`}>Visa & Entry Rules</a></li>
          <li><a href="/plan-your-trip/dhaka-airport-arrival-guide/" class={`mobile-sublink ${isActive('/plan-your-trip/dhaka-airport-arrival-guide/') ? 'active' : ''}`}>Airport Arrival (DAC)</a></li>
          <li><a href="/plan-your-trip/best-time-to-visit/" class={`mobile-sublink ${isActive('/plan-your-trip/best-time-to-visit/') ? 'active' : ''}`}>Best Time to Visit</a></li>
          <li><a href="/plan-your-trip/money-and-currency/" class={`mobile-sublink ${isActive('/plan-your-trip/money-and-currency/') ? 'active' : ''}`}>Money & ATMs</a></li>
          <li><a href="/plan-your-trip/sim-cards-and-esims/" class={`mobile-sublink ${isActive('/plan-your-trip/sim-cards-and-esims/') ? 'active' : ''}`}>SIM Cards & eSIMs</a></li>
          <li><a href="/plan-your-trip/transport-in-bangladesh/" class={`mobile-sublink ${isActive('/plan-your-trip/transport-in-bangladesh/') ? 'active' : ''}`}>Transport & Getting Around</a></li>
          <li><a href="/plan-your-trip/cultural-etiquette/" class={`mobile-sublink ${isActive('/plan-your-trip/cultural-etiquette/') ? 'active' : ''}`}>Cultural Etiquette</a></li>
        </ul>
      </li>

      <!-- Mobile Regular Links -->
      <li class="mobile-nav-item">
        <a href="/bangladesh-travel-safety/" class={`mobile-nav-link ${isActive('/bangladesh-travel-safety/') ? 'active' : ''}`}>
          Safety & Security
        </a>
      </li>
      <li class="mobile-nav-item">
        <a href="/bangladesh-travel-health/" class={`mobile-nav-link ${isActive('/bangladesh-travel-health/') ? 'active' : ''}`}>
          Health Care
        </a>
      </li>
      <li class="mobile-nav-item">
        <a href="/about/" class={`mobile-nav-link ${isActive('/about/') ? 'active' : ''}`}>
          About
        </a>
      </li>
    </ul>
  </nav>
</header>

<style>
  /* Base Header Layout */
  .site-header {
    background-color: var(--color-bg, #ffffff);
    border-bottom: 1px solid var(--color-border, #e5e7eb);
    position: sticky;
    top: 0;
    z-index: 1000;
  }

  .header-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0.875rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--color-text, #111827);
    font-weight: 700;
    font-size: 1.125rem;
  }

  .brand-icon {
    color: var(--color-primary, #047857);
  }

  /* Desktop Navigation */
  .desktop-nav {
    display: none;
  }

  @media (min-width: 768px) {
    .desktop-nav {
      display: block;
    }
    .mobile-menu-toggle {
      display: none;
    }
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-item {
    position: relative;
  }

  .nav-link-wrapper {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nav-link {
    color: var(--color-text, #374151);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.9375rem;
    padding: 0.5rem 0.25rem;
    transition: color 0.15s ease;
  }

  .nav-link:hover,
  .nav-link.active,
  .nav-item.active-section > .nav-link-wrapper > .nav-link {
    color: var(--color-primary, #047857);
  }

  .dropdown-toggle {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--color-text-muted, #6b7280);
    padding: 0.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    transition: color 0.15s ease, transform 0.2s ease;
  }

  .dropdown-toggle:hover {
    color: var(--color-primary, #047857);
  }

  .chevron-icon {
    transition: transform 0.2s ease;
  }

  .nav-item.open .chevron-icon,
  .mobile-has-dropdown.open .chevron-icon {
    transform: rotate(180deg);
  }

  /* Dropdown Menu (Desktop) */
  .dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 240px;
    background-color: var(--color-bg, #ffffff);
    border: 1px solid var(--color-border, #e5e7eb);
    border-radius: 8px;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
    padding: 0.5rem 0;
    list-style: none;
    margin-top: 0.75rem;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s ease;
    z-index: 1010;
  }

  .nav-item:hover .dropdown-menu,
  .nav-item.open .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .dropdown-link {
    display: block;
    padding: 0.5rem 1rem;
    color: var(--color-text, #374151);
    text-decoration: none;
    font-size: 0.875rem;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .dropdown-link:hover,
  .dropdown-link.active {
    background-color: var(--color-bg-hover, #f3f4f6);
    color: var(--color-primary, #047857);
    font-weight: 500;
  }

  /* Focus Indicator for Accessibility */
  .nav-link:focus-visible,
  .dropdown-toggle:focus-visible,
  .dropdown-link:focus-visible,
  .mobile-nav-link:focus-visible,
  .mobile-dropdown-btn:focus-visible {
    outline: 2px solid var(--color-primary, #047857);
    outline-offset: 2px;
  }

  /* Mobile Navigation Controls */
  .mobile-menu-toggle {
    background: none;
    border: none;
    padding: 0.5rem;
    cursor: pointer;
  }

  .hamburger-icon {
    display: block;
    width: 22px;
    height: 2px;
    background-color: var(--color-text, #111827);
    position: relative;
    transition: background-color 0.2s ease;
  }

  .hamburger-icon::before,
  .hamburger-icon::after {
    content: '';
    position: absolute;
    width: 22px;
    height: 2px;
    background-color: var(--color-text, #111827);
    left: 0;
    transition: transform 0.2s ease;
  }

  .hamburger-icon::before { top: -6px; }
  .hamburger-icon::after { top: 6px; }

  .mobile-nav {
    display: block;
    background-color: var(--color-bg, #ffffff);
    border-top: 1px solid var(--color-border, #e5e7eb);
    padding: 1rem 1.5rem;
  }

  .mobile-nav[hidden] {
    display: none;
  }

  @media (min-width: 768px) {
    .mobile-nav {
      display: none !important;
    }
  }

  .mobile-nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .mobile-nav-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .mobile-nav-link {
    color: var(--color-text, #111827);
    text-decoration: none;
    font-size: 1rem;
    font-weight: 500;
    padding: 0.5rem 0;
  }

  .mobile-nav-link.active {
    color: var(--color-primary, #047857);
  }

  .mobile-dropdown-btn {
    background: none;
    border: none;
    padding: 0.5rem;
    cursor: pointer;
    color: var(--color-text-muted, #6b7280);
  }

  .mobile-submenu {
    list-style: none;
    padding-left: 1rem;
    margin: 0.25rem 0 0.5rem 0;
    border-left: 2px solid var(--color-border, #e5e7eb);
  }

  .mobile-submenu[hidden] {
    display: none;
  }

  .mobile-sublink {
    display: block;
    padding: 0.375rem 0;
    color: var(--color-text-muted, #4b5563);
    text-decoration: none;
    font-size: 0.9375rem;
  }

  .mobile-sublink:hover,
  .mobile-sublink.active {
    color: var(--color-primary, #047857);
    font-weight: 500;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Mobile Main Menu Toggle
    const mobileMenuToggle = document.getElementById('mobileMenuToggle');
    const mobileNav = document.getElementById('mobileNav');

    if (mobileMenuToggle && mobileNav) {
      mobileMenuToggle.addEventListener('click', () => {
        const isExpanded = mobileMenuToggle.getAttribute('aria-expanded') === 'true';
        mobileMenuToggle.setAttribute('aria-expanded', String(!isExpanded));
        if (isExpanded) {
          mobileNav.setAttribute('hidden', '');
        } else {
          mobileNav.removeAttribute('hidden');
        }
      });
    }

    // 2. Desktop Dropdown Behavior (Hover, Focus, Keyboard)
    const desktopDropdownItems = document.querySelectorAll<HTMLElement>('.nav-item.has-dropdown');

    desktopDropdownItems.forEach((item) => {
      const toggleBtn = item.querySelector<HTMLButtonElement>('.dropdown-toggle');

      const openDropdown = () => {
        item.classList.add('open');
        toggleBtn?.setAttribute('aria-expanded', 'true');
      };

      const closeDropdown = () => {
        item.classList.remove('open');
        toggleBtn?.setAttribute('aria-expanded', 'false');
      };

      toggleBtn?.addEventListener('click', (e) => {
        e.preventDefault();
        const isOpen = item.classList.contains('open');
        if (isOpen) {
          closeDropdown();
        } else {
          desktopDropdownItems.forEach(other => other.classList.remove('open'));
          openDropdown();
        }
      });

      item.addEventListener('mouseenter', openDropdown);
      item.addEventListener('mouseleave', closeDropdown);

      item.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Escape') {
          closeDropdown();
          toggleBtn?.focus();
        }
      });
    });

    document.addEventListener('click', (e: MouseEvent) => {
      const target = e.target as Node;
      desktopDropdownItems.forEach((item) => {
        if (!item.contains(target)) {
          item.classList.remove('open');
          item.querySelector('.dropdown-toggle')?.setAttribute('aria-expanded', 'false');
        }
      });
    });

    // 3. Mobile Submenu Accordion Toggles
    const mobileDropdownBtns = document.querySelectorAll<HTMLButtonElement>('.mobile-dropdown-btn');

    mobileDropdownBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const parentItem = btn.closest('.mobile-has-dropdown');
        const submenu = parentItem?.querySelector<HTMLUListElement>('.mobile-submenu');
        const isExpanded = btn.getAttribute('aria-expanded') === 'true';

        btn.setAttribute('aria-expanded', String(!isExpanded));
        if (parentItem) {
          parentItem.classList.toggle('open', !isExpanded);
        }

        if (submenu) {
          if (isExpanded) {
            submenu.setAttribute('hidden', '');
          } else {
            submenu.removeAttribute('hidden');
          }
        }
      });
    });
  });
</script>