---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';

interface Props {
  title: string;
  description: string;
  lastUpdated: string;
}

const { title, description, lastUpdated } = Astro.props;

const breadcrumbs = [
  { name: title, path: Astro.url.pathname }
];
---

<BaseLayout title={title} description={description}>
  <div class="container content-narrow section">
    <Breadcrumbs items={breadcrumbs} />

    <header class="legal-header">
      <h1 class="legal-title">{title}</h1>
      <p class="legal-updated">Effective Date: {lastUpdated}</p>
    </header>

    <div class="legal-body">
      <slot />
    </div>
  </div>
</BaseLayout>

<style>
  .legal-header {
    margin-bottom: var(--spacing-xl);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--spacing-md);
  }

  .legal-title {
    font-family: var(--font-heading);
    font-size: 2rem;
    color: var(--color-primary-dark);
    margin-bottom: var(--spacing-xs);
  }

  .legal-updated {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .legal-body {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-text);
  }

  .legal-body :global(h2) {
    font-family: var(--font-heading);
    font-size: 1.375rem;
    color: var(--color-primary-dark);
    margin-top: var(--spacing-xl);
    margin-bottom: var(--spacing-sm);
  }

  .legal-body :global(p) {
    margin-bottom: var(--spacing-md);
  }

  .legal-body :global(ul) {
    margin-bottom: var(--spacing-md);
    padding-left: var(--spacing-lg);
  }
</style>