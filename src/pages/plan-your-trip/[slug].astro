---
import { getCollection, type CollectionEntry } from 'astro:content';
import ArticleLayout from '@layouts/ArticleLayout.astro';

export async function getStaticPaths() {
  const guides = await getCollection('guides', ({ data, slug }) => 
    !data.draft && slug !== 'bangladesh-travel-safety' && slug !== 'bangladesh-travel-health'
  );
  return guides.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'guides'>;
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const breadcrumbs = [
  { name: 'Plan Your Trip', path: '/plan-your-trip/' },
  { name: entry.data.title, path: `/plan-your-trip/${entry.slug}/` }
];
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  publishDate={entry.data.publishDate}
  updatedDate={entry.data.updatedDate}
  category={entry.data.category}
  breadcrumbs={breadcrumbs}
  sources={entry.data.sources}
  featuredImage={entry.data.featuredImage}
  featuredImageAlt={entry.data.featuredImageAlt}
>
  <Content />
</ArticleLayout>